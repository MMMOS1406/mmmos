    { "source": "/api/youtube/link", "destination": "/api/youtube/detect.js" },
    { "source": "/api/packages/sync", "destination": "/api/youtube/detect.js" },
    { "source": "/api/ops",           "destination": "/api/ops.js" },
    { "source": "/api/queue/process", "destination": "/api/queue.js" },
    { "source": "/api/queue/add",     "destination": "/api/queue.js" },
    { "source": "/api/queue/status",  "destination": "/api/queue.js" },
    { "source": "/api/youtube/detect", "destination": "/api/youtube/detect.js" },
    { "source": "/api/reports/weekly", "destination": "/api/reports/weekly.js" },
    { "source": "/api/generate", "destination": "/api/generate.js" },
