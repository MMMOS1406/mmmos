#!/bin/sh
# MMMOS Engineering Runner — git pre-push guard (R2 post-release, NOT INSTALLED).
# Enforced only inside runner worktrees (under $MMMOS_RUNNER_ROOT, default
# ~/mmm-static-wt/runner/); every other checkout is left untouched (exit 0).
# Inside a runner worktree it refuses:
#   - pushing to any branch other than runner/*  (so never main)
#   - deleting a branch
#   - non-fast-forward (force) updates
# It is defence in depth: a Claude Code deny rule also blocks --no-verify.
ROOT="${MMMOS_RUNNER_ROOT:-$HOME/mmm-static-wt/runner}"
TOP="$(git rev-parse --show-toplevel 2>/dev/null)"
ROOT_REAL="$(cd "$ROOT" 2>/dev/null && pwd -P)"
TOP_REAL="$(cd "$TOP" 2>/dev/null && pwd -P)"
# No runner folder (or no checkout) → nothing to enforce. An empty ROOT_REAL must
# never turn into a pattern that matches every path.
[ -n "$ROOT_REAL" ] && [ -n "$TOP_REAL" ] || exit 0
case "$TOP_REAL/" in
  "$ROOT_REAL"/*) ;;
  *) exit 0 ;;
esac
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/runner/*) ;;
    *) echo "RUNNER PUSH GUARD: refusing to push to $remote_ref (runner may push only runner/* branches)" >&2; status=1; continue ;;
  esac
  if [ "$local_sha" = "$ZERO" ]; then
    echo "RUNNER PUSH GUARD: refusing to delete $remote_ref" >&2; status=1; continue
  fi
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "RUNNER PUSH GUARD: refusing a force (non-fast-forward) push to $remote_ref" >&2; status=1; continue
  fi
done
exit $status
