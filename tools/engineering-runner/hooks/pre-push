#!/bin/sh
# MMMOS Engineering Runner — git pre-push guard (installed in 030).
# Installed copy: /Users/abdulmahmady/MMM/engineering-agent/hooks/pre-push, bound with
#   git -C ~/mmmos-runner/repo config core.hooksPath /Users/abdulmahmady/MMM/engineering-agent/hooks
# It enforces when ANY of these is true (an environment variable can add enforcement, never remove it):
#   - the checkout is inside the dedicated runner folder ~/mmmos-runner
#   - the checkout has  git config mmmos.runner true
#   - the checkout is inside $MMMOS_RUNNER_ROOT (used by tests)
# Every other checkout is left untouched (exit 0).
# When enforcing it refuses:
#   - pushing to any ref other than refs/heads/runner/*  (so never main, never tags)
#   - deleting a branch
#   - non-fast-forward (force) updates
# Client-side hooks can be skipped (--no-verify, -c core.hooksPath=...). The real backstop is the
# GitHub ruleset on main (PR required, no force push, no deletion); see docs/platform/RUNNER_ISOLATION.md.
TOP="$(git rev-parse --show-toplevel 2>/dev/null)"
TOP_REAL="$(cd "$TOP" 2>/dev/null && pwd -P)"
[ -n "$TOP_REAL" ] || exit 0
enforce=0
under() { r="$(cd "$1" 2>/dev/null && pwd -P)"; [ -n "$r" ] || return 1; case "$TOP_REAL/" in "$r"/*) return 0 ;; esac; return 1; }
under "$HOME/mmmos-runner" && enforce=1
[ "$(git config --get mmmos.runner 2>/dev/null)" = "true" ] && enforce=1
[ -n "$MMMOS_RUNNER_ROOT" ] && under "$MMMOS_RUNNER_ROOT" && enforce=1
[ "$enforce" = 1 ] || exit 0
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/runner/*) ;;
    *) echo "RUNNER PUSH GUARD: refusing to push to $remote_ref (runner may push only runner/* branches)" >&2; status=1; continue ;;
  esac
  if [ "$local_sha" = "$ZERO" ]; then
    echo "RUNNER PUSH GUARD: refusing to delete $remote_ref" >&2; status=1; continue
  fi
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "RUNNER PUSH GUARD: refusing a force (non-fast-forward) push to $remote_ref" >&2; status=1; continue
  fi
done
exit $status
